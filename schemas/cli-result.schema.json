{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/mohui666/threejs-unity-benchmark/main/schemas/cli-result.schema.json",
  "title": "Three.js Unity Benchmark CLI Result",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "command", "ok", "status", "data", "artifacts", "warnings", "errors"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "command": { "type": "string", "minLength": 1 },
    "ok": { "type": "boolean" },
    "status": { "enum": ["pass", "regression", "inconclusive", "error"] },
    "data": {},
    "artifacts": { "type": "array", "items": { "type": "string" } },
    "warnings": { "type": "array", "items": { "type": "string" } },
    "errors": { "type": "array", "items": { "type": "string" } }
  }
}
